- name: Install base packages
 ansible.builtin.apt:
name:
 - ca-certificates
 - curl
 - gnupg
 - apt-transport-https
state: present
update_cache: true

Dmytro Vasiliev 20:21
- name: zabbix-agent2
 apt:
update_cache: yes
name:
 - zabbix-agent2
 - zabbix-agent2-plugin-*
 - name: Enabling zabbix-agent2
systemd:
name: zabbix-agent2
enabled: yes
state: restarted

Dmytro Vasiliev 20:28
- name: Gather runner VM information by name
 community.proxmox.proxmox_vm_info:
node: "{{ proxmox_node }}"
name: "{{ runner_vm_name }}"
type: qemu
register: runner_vm_info_by_name
- name: stat out
 ansible.builtin.command:
cmd: systemctl status zabbix-agent2
register: out
 - name: output execution
debug: var=out.stdout_lines

